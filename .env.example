# Para o MySQL local criado pelo Docker
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sosplus_01
MYSQL_USER=sosplus
MYSQL_PASSWORD=sosplus_dev_local
MYSQL_ROOT_PASSWORD=sosplus_root_dev_local

# Chave exclusiva do ambiente, com 32 bytes em hexadecimal. Gere com: openssl rand -hex 32
PERSONAL_DATA_ENCRYPTION_KEY=

# Portas publicadas pelo Docker no computador
MYSQL_PUBLISHED_PORT=3306
API_PUBLISHED_PORT=3000
SMTP_PUBLISHED_PORT=1025
MAILPIT_WEB_PUBLISHED_PORT=8025

# Recuperação somente local. Ative ao executar a API no computador com Mailpit ligado.
RECOVERY_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@sosplus.local

# Porta HTTP da API
PORT=3000

# Logs de diagnóstico. SQL mostra a consulta com placeholders e resume os parâmetros,
# sem imprimir senhas, tokens, fotos ou dados pessoais em texto puro.
LOG_LEVEL=DEBUG
LOG_HTTP=true
LOG_SQL=true
